{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/pages/shop.html" },
    { "source": "/product/:slug", "destination": "/pages/product.html" },
    { "source": "/cart", "destination": "/pages/cart.html" },
    { "source": "/checkout", "destination": "/pages/checkout.html" },
    { "source": "/wishlist", "destination": "/pages/wishlist.html" },
    { "source": "/orders", "destination": "/pages/orders.html" },
    { "source": "/profile", "destination": "/pages/profile.html" },
    { "source": "/login", "destination": "/pages/login.html" },
    { "source": "/register", "destination": "/pages/register.html" },
    { "source": "/forgot-password", "destination": "/pages/forgot-password.html" },
    { "source": "/reset-password", "destination": "/pages/reset-password.html" },
    { "source": "/setup", "destination": "/setup.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/products", "destination": "/admin/products.html" },
    { "source": "/admin/categories", "destination": "/admin/categories.html" },
    { "source": "/admin/orders", "destination": "/admin/orders.html" },
    { "source": "/admin/customers", "destination": "/admin/customers.html" },
    { "source": "/admin/coupons", "destination": "/admin/coupons.html" },
    { "source": "/admin/analytics", "destination": "/admin/analytics.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  }
}
