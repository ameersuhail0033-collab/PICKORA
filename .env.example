[TEMPLATE]
# =============================================================
# PICKORA STORE — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================

# ─── Supabase ────────────────────────────────────────────────
# Project URL (Settings → API → Project URL)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key — safe for browser (Settings → API → publishable / anon)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret key — NEVER expose to client (Settings → API → secret / service_role)
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Nomod Payment Gateway ───────────────────────────────────
# Hosted Checkout API key (Settings → Tools → Apps & APIs → Hosted Checkout → API Key)
# Use test credentials for testing, live credentials for production.
# There is NO separate test API endpoint — test mode is controlled by the credentials.
NOMOD_HOSTED_CHECKOUT_API_KEY=sk_live_zAOPMafK.FPwhEwcrlOFYbh6KV6cwofuyGq5NoFkR

# Webhook signing secret (Settings → Tools → Apps & APIs → Webhooks → Signing secret)
NOMOD_WEBHOOK_SECRET=whsec_xNMSWrXneVIE6f4UBnuopOlq6cLsN1Z6

# Payment mode — UI display only (does NOT control the API endpoint)
# "test" shows test badges in admin; "live" removes them
PUBLIC_PAYMENT_MODE=test

# ─── Admin Setup ─────────────────────────────────────────────
# One-time setup secret for creating the first admin account.
# Generate a strong random string (e.g. openssl rand -hex 32).
# This is used by /api/setup-admin to verify the store owner.
# NEVER put this in js/env.js or any client-side file.
SETUP_ADMIN_SECRET=a174b59d5037ed56547fb9d3ca7c4f0d78aff62245ec24d3fd0283bbf6a4a235

# ─── Site ────────────────────────────────────────────────────
# Full site URL including protocol (no trailing slash)
PUBLIC_SITE_URL=https://your-domain.com

# Store display name (used in HTML title, emails, etc.)
PUBLIC_STORE_NAME=Pickora Laptops

# Support email for contact pages and emails
PUBLIC_SUPPORT_EMAIL=support@your-domain.com

# ─── Email (Optional) ────────────────────────────────────────
# Resend API key for transactional emails (optional; if omitted, emails no-op)
RESEND_API_KEY=re_xxx

# From address for emails (must be from a verified Resend domain)
EMAIL_FROM=noreply@your-domain.com

# ─── Store Defaults (used only during setup wizard) ──────────
PUBLIC_STORE_CURRENCY=AED
PUBLIC_STORE_LOGO=
PUBLIC_STORE_FAVICON=
